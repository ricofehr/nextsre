# Copy to .env and adjust. All values have sensible defaults in compose.

# ---- Local LLM (OpenAI-compatible endpoint on the host) ----
# Ollama default:
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma3:27b
LLM_API_KEY=local
# llama.cpp llama-server example:
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=gemma-3-27b-it

# ---- Demo vs real backends ----
# 1 = synthetic incident (no cluster needed).
# 0 = real K8s/Prometheus/Loki/Tempo (needs [real] extras + creds).
# Parsed strictly: 1/0/true/false/yes/no/on/off. Anything else raises at startup
# rather than being read as "not demo" and pointing the write tools at prod.
DEMO_MODE=1

# ---- Observer ----
# 1 = observe-only: the Observer loses request_remediation and recommends a fix
# in its report instead; no Operator is needed. Parsed strictly like DEMO_MODE.
# 0 (default) = it may delegate a remediation to the Operator over A2A.
# OBSERVE_ONLY=0
# Per-read budget for the Observer's call to the Operator, in seconds. Keep it
# below OBSERVER_TIMEOUT_S; raise both for a slow local model.
# OPERATOR_TIMEOUT_S=120

# ---- Operator harness ----
# Comma-separated; surrounding whitespace and empty entries are ignored.
# An allowlist that parses empty refuses every write.
ALLOWED_NAMESPACES=web,payments,staging
MAX_REPLICAS=20
# Scaling to 0 is a full outage, so it needs a separate opt-in: the replica
# floor is 1 unless this is set.
# ALLOW_SCALE_TO_ZERO=0
# 1 = pause before any write tool runs and wait for human approval.
REQUIRE_APPROVAL=0
# Narrows shell-exec's built-in binary allowlist (it can never add to it). Unset
# keeps the full list; a value that matches none of it refuses every command.
# In a Kubernetes pod use kubectl only: host tools would describe the container.
# Not passed by docker-compose (an empty value there would refuse everything).
# SHELL_BINARIES=kubectl

# ---- Network binding ----
# Applies to all six MCP servers AND both agent servers. Everything binds
# loopback by default; compose overrides this to 0.0.0.0 because there the
# container network is the isolation boundary. None of these services
# authenticates its caller - never bind one to a public interface.
# MCP_BIND_HOST=127.0.0.1
#
# Host/Origin allowlist for the MCP servers (DNS-rebinding protection). Each
# server always accepts its own compose service name; add any other name callers
# use to reach it. Defaults to 127.0.0.1,localhost.
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- OpenTelemetry self-instrumentation (optional; no-op when unset) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.kube-tracing.svc.cluster.local:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=

# ---- Ingestion gateway ----
# Bearer token Alertmanager must send. Optional in demo mode; with DEMO_MODE=0
# the gateway refuses to start without it.
# WEBHOOK_AUTH_TOKEN=
# Upper bound on a whole Observer investigation, in seconds. A local model at
# 15-20 tok/s needs several minutes: 900 is a sensible value there.
# OBSERVER_TIMEOUT_S=180
# Where the Observer's report is published (console always):
# SLACK_WEBHOOK_URL=
# NOTIFICATION_WEBHOOK_URL=

# ---- Real backends only (DEMO_MODE=0) ----
# ALERTMANAGER_URL=http://alertmanager:9093
# PROMETHEUS_URL=http://prometheus:9090
# LOKI_URL=http://loki-gateway.kube-logcollect.svc.cluster.local
# LOKI_USERNAME=
# LOKI_PASSWORD=
# TEMPO_URL=http://tempo.kube-tracing.svc.cluster.local:3200
